[
  {
    "name": "check",
    "description": "vet packages, the lockfile, install scripts, or registry config",
    "positional": {
      "kind": "<pkg[@version]... | lockfile | scripts | config>",
      "values": [
        "lockfile",
        "scripts",
        "config"
      ]
    },
    "flags": [
      {
        "name": "--json",
        "description": "write verdict JSON to stdout",
        "valueHint": null
      },
      {
        "name": "--allow-risky",
        "description": "permit blocked packages and exit 10",
        "valueHint": null
      },
      {
        "name": "--dir",
        "description": "directory to audit for a surface check",
        "valueHint": "<path>"
      },
      {
        "name": "--help",
        "description": "show this help",
        "valueHint": null
      }
    ],
    "exitCodes": "0 allow · 10 warn · 20 block · 30 error",
    "example": "warden check lockfile --json"
  },
  {
    "name": "install",
    "description": "vet packages, then install them with lifecycle scripts suppressed",
    "positional": {
      "kind": "[pkg[@version]...]"
    },
    "flags": [
      {
        "name": "--npm|--pnpm|--yarn|--bun",
        "description": "install with that manager instead of the detected one",
        "valueHint": null
      },
      {
        "name": "--json",
        "description": "write the verdicts to stdout",
        "valueHint": null
      },
      {
        "name": "--allow-risky",
        "description": "install even when a package is blocked",
        "valueHint": null
      },
      {
        "name": "--help",
        "description": "show this help",
        "valueHint": null
      }
    ],
    "exitCodes": "0 installed · 20 blocked · 30 error",
    "example": "warden install --bun express"
  },
  {
    "name": "ci",
    "description": "run all checks against the merge-base diff",
    "positional": null,
    "flags": [
      {
        "name": "--reporter",
        "description": "select human, JSON, workflow, agent, or SARIF output",
        "valueHint": "<summary|json|github|agent|sarif>"
      },
      {
        "name": "--base",
        "description": "compare against this git ref",
        "valueHint": "<ref>"
      },
      {
        "name": "--intent-prompt",
        "description": "also verify the diff against this prompt",
        "valueHint": "<text>"
      },
      {
        "name": "--require-transaction-receipt",
        "description": "fail when the dependency graph changed without a valid warden receipt",
        "valueHint": null
      },
      {
        "name": "--help",
        "description": "show this help",
        "valueHint": null
      }
    ],
    "exitCodes": "0 clean · 10 warn · 20 block · 30 error",
    "example": "warden ci --reporter github --base origin/main"
  },
  {
    "name": "doctor",
    "description": "audit dependencies for CVEs, gate the fixes, verify, and apply",
    "positional": null,
    "flags": [
      {
        "name": "--dir",
        "description": "project directory (default .)",
        "valueHint": "<path>"
      },
      {
        "name": "--json",
        "description": "write the doctor report JSON to stdout",
        "valueHint": null
      },
      {
        "name": "--no-apply",
        "description": "report and plan only, do not modify package.json",
        "valueHint": null
      },
      {
        "name": "--no-verify",
        "description": "skip isolated-workspace verification of plans",
        "valueHint": null
      },
      {
        "name": "--help",
        "description": "show this help",
        "valueHint": null
      }
    ],
    "exitCodes": "0 clean or fully fixed · 10 unresolved issues · 30 error",
    "example": "warden doctor --no-apply --json"
  },
  {
    "name": "intent",
    "description": "verify the diff does what the prompt asked",
    "positional": {
      "kind": "[check|extract|diff|symbols|schema]"
    },
    "flags": [
      {
        "name": "--prompt",
        "description": "the instruction the agent was given",
        "valueHint": "<text>"
      },
      {
        "name": "--base",
        "description": "compare against this git ref",
        "valueHint": "<ref>"
      },
      {
        "name": "--json",
        "description": "write the intent report JSON to stdout",
        "valueHint": null
      },
      {
        "name": "--help",
        "description": "show this help",
        "valueHint": null
      }
    ],
    "exitCodes": "0 met · 10 partial/scope creep · 20 dropped or hallucinated · 30 error",
    "example": "warden intent check --prompt \"add rate limiting to the api client\""
  },
  {
    "name": "plan",
    "description": "resolve the prospective dependency graph and decide before anything installs",
    "positional": {
      "kind": "[-- <manager> <command>|<pkg>...]"
    },
    "flags": [
      {
        "name": "--npm|--pnpm|--yarn|--bun",
        "description": "plan for that manager instead of the detected one",
        "valueHint": null
      },
      {
        "name": "--json",
        "description": "write the transaction plan to stdout",
        "valueHint": null
      },
      {
        "name": "--help",
        "description": "show this help",
        "valueHint": null
      }
    ],
    "exitCodes": "0 allow · 10 warn or needs approval · 20 block · 30 error",
    "example": "warden plan -- npm install @fastify/jwt"
  },
  {
    "name": "apply",
    "description": "install a planned transaction with scripts suppressed, then verify it",
    "positional": {
      "kind": "<plan-id>"
    },
    "flags": [
      {
        "name": "--no-verify",
        "description": "skip the project verification steps",
        "valueHint": null
      },
      {
        "name": "--allow-unapproved",
        "description": "install even when scripts are unapproved",
        "valueHint": null
      },
      {
        "name": "--json",
        "description": "write the transaction receipt to stdout",
        "valueHint": null
      },
      {
        "name": "--help",
        "description": "show this help",
        "valueHint": null
      }
    ],
    "exitCodes": "0 applied · 20 refused · 30 rolled back or error",
    "example": "warden apply wtxn_0a1b2c3d"
  },
  {
    "name": "approve-script",
    "description": "approve one lifecycle script, bound to its version, integrity, and body",
    "positional": {
      "kind": "<pkg@version>"
    },
    "flags": [
      {
        "name": "--hook",
        "description": "the lifecycle hook being approved",
        "valueHint": "<name>"
      },
      {
        "name": "--scope",
        "description": "where the approval is recorded",
        "valueHint": "<repo|user>"
      },
      {
        "name": "--integrity",
        "description": "pin a specific tarball",
        "valueHint": "<sha512-...>"
      },
      {
        "name": "--note",
        "description": "why this script was approved",
        "valueHint": "<text>"
      },
      {
        "name": "--json",
        "description": "write the approval record to stdout",
        "valueHint": null
      },
      {
        "name": "--help",
        "description": "show this help",
        "valueHint": null
      }
    ],
    "exitCodes": "0 approved · 30 error",
    "example": "warden approve-script esbuild@0.25.8 --hook postinstall"
  },
